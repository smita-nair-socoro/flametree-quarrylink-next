# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# NextAuth URL (set to the deployed URL)
AUTH_URL=https://flametree-quarrylink-next-staging.onrender.com

# Database (Neon PostgreSQL for user storage)
DATABASE_URL=

# Orchestrator service URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://flametree-quarrylink-service-staging.onrender.com

# Tenant Fusion service URL (no trailing slash)
NEXT_PUBLIC_TENANT_FUSION_URL=https://flametree-quarrylink-tenant-fusion-service-staging.onrender.com

# Default tenant ID (used as fallback if user has no tenant)
NEXT_PUBLIC_TENANT_ID=tenant-001

# Google Maps API Key (optional, for address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
