# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Use 2 spaces for indentation
indent_style = space
indent_size = 2

# JavaScript, TypeScript, and related files
[*.{js,jsx,ts,tsx}]
# (inherits indent and charset from [*])
quote_type = single

# JSON files (package.json, tsconfig.json, etc.)
[*.json]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML / GitHub Actions workflows
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# CSS, SCSS, and other styles
[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2

# SVGs and XML files
[*.{svg,xml}]
indent_style = space
indent_size = 2

# Ignore build output (optional, for clarity – most editors ignore .next by default)
[.next/**]
indent_style = unset

