# E2E test environment variables
# Copy this file to .env.e2e and fill in the values
#
# The DATABASE_URL and DIRECT_URL should point to a STAGING or test database,
# NEVER the production database.

# NextAuth secret (same as staging)
E2E_AUTH_SECRET=your-auth-secret-here

# Neon database connection (staging)
E2E_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&pgbouncer=true
E2E_DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Backend service URLs (staging)
E2E_DOWNSTREAM_URL=https://flametree-quarrylink-service-staging.onrender.com
E2E_TENANT_FUSION_URL=https://flametree-tenantfusion-staging.onrender.com

# CloudFront / S3
E2E_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net
E2E_S3_BUCKET=your-s3-bucket-name

# Email
E2E_RESEND_API_KEY=your-resend-api-key
E2E_EMAIL_FROM=QuarryLink <noreply@quarrylink.com.au>
